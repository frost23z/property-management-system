# Django
DJANGO_SECRET_KEY=replace-with-a-secure-secret-key
# Generate a new secret key with: uv run python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=propertydb
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Semantic search (FastEmbed)
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Largest cosine distance (0 = identical) at which a location counts as a semantic match
# SEMANTIC_MAX_DISTANCE=0.5
# Where FastEmbed caches the downloaded model (defaults to a temp folder)
# FASTEMBED_CACHE_PATH=.cache/fastembed
